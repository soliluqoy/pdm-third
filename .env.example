# =============================================================================
# PREDICT — environment (copy to .env). Defaults work out of the box.
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=predict
POSTGRES_PASSWORD=predict_dev_password
POSTGRES_DB=predict

# Full SQLAlchemy URL. Inside docker-compose this is auto-set to the db service.
# For local dev (uvicorn on your machine, db from compose):
# DATABASE_URL=postgresql+asyncpg://predict:predict_dev_password@localhost:5432/predict

# ── Teltonika listener ────────────────────────────────────────────────────────
TELTONIKA_HOST=0.0.0.0
TELTONIKA_PORT=5123
# Idle seconds before a silent tracker connection is closed
TELTONIKA_IDLE_TIMEOUT=300

# ── Public host (used only to pre-fill SMS setup templates in Settings) ──────
# Set to your VPS static IP / hostname so the copy-paste SMS is ready to send.
TRACKER_PUBLIC_HOST=<YOUR_SERVER_IP>

# ── Optional single-admin login ──────────────────────────────────────────────
# Set ADMIN_PASSWORD to require a password on the dashboard + API + WebSocket.
# Leave empty to disable auth (local dev). AUTH_SECRET signs session cookies;
# if unset a secret is generated and persisted to a file automatically.
# ADMIN_PASSWORD=
# AUTH_SECRET=

# ── Rules / freshness ─────────────────────────────────────────────────────────
# Trackers buffer records when out of coverage. Readings are always stored,
# but rules only fire for records fresher than this (no phantom alerts).
RULE_MAX_RECORD_AGE_SECONDS=300

# A car is shown offline (grey) after this many seconds without data
OFFLINE_AFTER_SECONDS=300

# Raw readings retention; 1m/1h aggregates are kept beyond this
READINGS_RETENTION_DAYS=365

# Assumed tracker sample period (seconds) when converting reading counts → minutes
# for thermal / high-RPM features. Sim uses 5; FMC001 SMS setup often uses 10.
# TELEMETRY_SAMPLE_SECONDS=10
